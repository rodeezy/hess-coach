<main class="mx-auto max-w-sm px-4 py-16">
  <h1 class="text-xl font-semibold tracking-tight">Sign in</h1>

  <% if alert = flash[:alert] %>
    <p class="mt-4 rounded-lg border border-red-400 px-3 py-2 text-sm text-red-600
              dark:border-red-800 dark:text-red-400"><%= alert %></p>
  <% end %>
  <% if notice = flash[:notice] %>
    <p class="mt-4 rounded-lg border border-emerald-400 px-3 py-2 text-sm text-emerald-700
              dark:border-emerald-800 dark:text-emerald-400"><%= notice %></p>
  <% end %>

  <%= form_with url: login_path, class: "mt-6 space-y-4" do |f| %>
    <div>
      <%= f.label :email_address, "Email", class: "block text-sm font-medium" %>
      <%= f.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", class: "field mt-1" %>
    </div>
    <div>
      <%= f.label :password, "Password", class: "block text-sm font-medium" %>
      <%= f.password_field :password, required: true, autocomplete: "current-password",
            class: "field mt-1" %>
    </div>
    <%= f.submit "Sign in", class: "btn-primary w-full" %>
  <% end %>

  <p class="mt-4 text-sm">
    <%= link_to "Forgot password?", new_password_path, class: "underline" %>
  </p>
</main>
