<main class="mx-auto max-w-sm px-4 py-16">
  <h1 class="text-xl font-semibold tracking-tight">Forgot your password?</h1>

  <% if alert = flash[:alert] %>
    <p class="mt-4 rounded-lg border border-red-400 px-3 py-2 text-sm text-red-600
              dark:border-red-800 dark:text-red-400"><%= alert %></p>
  <% end %>

  <%= form_with url: passwords_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "block text-sm font-medium" %>
      <%= form.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address], class: "field mt-1" %>
    </div>
    <%= form.submit "Email reset instructions", class: "btn-primary w-full" %>
  <% end %>

  <p class="mt-4 text-sm"><%= link_to "Back to sign in", login_path, class: "underline" %></p>
</main>
